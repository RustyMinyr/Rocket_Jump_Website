# Public canonical URL used for metadata, sitemap and social sharing.
NEXT_PUBLIC_SITE_URL=https://www.rocketjump.co.za

# Contact-form delivery credentials. These values are server-side only.
# Never prefix secrets with NEXT_PUBLIC_.
RESEND_API_KEY=
EMAIL_FROM=Rooiko <contact@rooiko.com>
CONTACT_TO_EMAIL=hello@rocketjump.co.za

# Coolify runtime. Use this site's own private PostgreSQL instance and URL.
# Leave DATABASE_DRIVER unset only on the current Vercel deployment, which uses Neon.
DATABASE_DRIVER=pg
DATABASE_URL=
ROLAND_GAME_ORIGIN=https://www.rocketjump.co.za
TRUST_COOLIFY_PROXY=1

# Set only on the old deployment during the final write freeze, then redeploy.
# Keep unset on the new site after cutover.
MIGRATION_READ_ONLY=

# Optional website verification and third-party analytics values.
# Drifter first-party gameplay statistics use their own in-game controls.
NEXT_PUBLIC_SEARCH_CONSOLE_VERIFICATION=
NEXT_PUBLIC_ANALYTICS_ID=

# Drifter owner dashboard. Set only on the server; keep the setup token private.
# The matching game account must also enter this one-time token at /admin.
DRIFTER_ADMIN_EMAIL=
DRIFTER_ADMIN_BOOTSTRAP_TOKEN=
