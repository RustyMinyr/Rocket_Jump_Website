# Public canonical URL used for metadata, sitemap and social sharing.
NEXT_PUBLIC_SITE_URL=https://www.rocketjump.co.za

# Contact-form delivery credentials. These values are server-side only.
# Never prefix secrets with NEXT_PUBLIC_.
RESEND_API_KEY=
EMAIL_FROM=Rooiko <contact@rooiko.com>
CONTACT_TO_EMAIL=hello@rocketjump.co.za

# Optional verification and analytics values. No tracking is active by default.
NEXT_PUBLIC_SEARCH_CONSOLE_VERIFICATION=
NEXT_PUBLIC_ANALYTICS_ID=
